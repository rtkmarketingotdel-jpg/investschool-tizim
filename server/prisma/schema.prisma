// REFERENCE ONLY. Not used at runtime while the server runs on mock data.
// Full schema lives in the project spec (section 7); paste it here when the Postgres host is ready.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { DIRECTOR ACCOUNTANT ADMIN STAFF }
enum Lang { uz ru }

model User {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  position     String
  baseSalary   Int      @default(0)
  language     Lang     @default(uz)
  isActive     Boolean  @default(true)
  hiredAt      DateTime @default(now())
  createdAt    DateTime @default(now())
}
